{
  "name": "null",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NULL: a plain black-and-white hub for games, apps, proxies and tools. Static HTML/CSS/JS: GitHub Pages serves these files as-is, and Node is only the build-time tooling (catalog scan, icon font subset, single-file releases, link check).",
  "homepage": "https://googleslides2026.github.io/null-edits/",
  "repository": {
    "type": "git",
    "url": "https://github.com/googleslides2026/null-edits.git"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "catalog": "node scripts/build-catalog.js",
    "font": "node scripts/build-font.js",
    "releases": "node scripts/build-releases.js",
    "build": "node scripts/build-catalog.js && node scripts/build-releases.js",
    "check:links": "node scripts/check-links.js",
    "check:releases": "node scripts/check-releases.js",
    "check:pages": "node scripts/check-pages.js",
    "check": "tsc -b"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "fontverter": "^2.0.0",
    "harfbuzzjs": "^1.6.1",
    "jsdom": "^30.0.1",
    "subset-font": "^2.7.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.5"
  },
  "dependencies": {
    "@vly-ai/integrations": "^0.6.13"
  }
}
