{
  "name": "null",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NULL: a plain black-and-white hub for games, apps, proxies and tools. Static HTML/CSS/JS: GitHub Pages serves these files as-is, and Node is only the build-time tooling (catalog scan, icon set, link and page checks).",
  "homepage": "https://googleslides2026.github.io/",
  "repository": {
    "type": "git",
    "url": "https://github.com/googleslides2026/googleslides2026.github.io.git"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "catalog": "node scripts/build-catalog.js",
    "icons": "node scripts/build-icons.js",
    "build": "node scripts/build-catalog.js && node scripts/build-icons.js",
    "check:links": "node scripts/check-links.js",
    "check:pages": "node scripts/check-pages.js",
    "check": "tsc -b"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "lucide-static": "^1.47.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.5"
  },
  "dependencies": {
    "@vly-ai/integrations": "^0.6.13"
  }
}
