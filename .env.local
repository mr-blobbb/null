DOTENV_PUBLIC_KEY_LOCAL="0288bd348c6908faea34b9d3dc52a87be55b5cb5b7a87f53de3e7411420228cb11"

# .env.local
# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=https://flexible-woodpecker-201.convex.cloud

# Convex site URL for auth
CONVEX_SITE_URL=https://flexible-woodpecker-201.convex.site

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=dev:flexible-woodpecker-201 # team: evan-price, project: wet-pigs-rescue
VITE_VLY_APP_ID="wet-pigs-rescue"
VITE_VLY_MONITORING_URL="https://harmless-tapir-303.convex.site/runtime-error"
